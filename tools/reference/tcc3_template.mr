import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

/*
    University of Michigan TCC-III optical SI engine (Full View hardware).
    Generated by tools/reference/tcc3_build_mr.py from docs/reference/batch03/tcc3
    (UM Motored Full View archive). Do not hand-edit. Grades D unless noted.
      bore 92, stroke 86, CR 10 (TDC 63.5 cc), rod 231 mm (README; GT model 234.95, F)
      valve lift: measured arrays (peak 8.89 mm); peak lift at 114.8 / 606.8 CA aTDCe
      valve flow: Cd vs L/D on the 25.4 mm reference (UM GT-Power model; F-hardware),
        0.2275 CFM per mm2 effective area (project convention); port_cd fixed at 1
      intake path: flange + runner + sensor + spacer 185.7 mm, port 94.2 mm, 25.4 mm dia
      exhaust path: port 94.2 mm; sensor + runner + flange 167 mm, 25.4 mm dia
      plenums ~11 L each (README rectangular sections; lower transition U)
      walls 323 K (UM GT model setting, F); measured cylinder outer surface 36-42 C
      motored: no fuel (molecular_afr 1e6); intake supply temperature = measured plenum T
*/

private node tcc3_intake_flow {
    input cd: 1.0;
    alias output __out: f;
    function f(25 * units.thou)
    f
@INTAKE_FLOW@
}

private node tcc3_exhaust_flow {
    input cd: 1.0;
    alias output __out: f;
    function f(25 * units.thou)
    f
@EXHAUST_FLOW@
}

private node tcc3_intake_lobe {
    alias output __out: f;
    function f(1 * units.deg)
    f
@INTAKE_LOBE@
}

private node tcc3_exhaust_lobe {
    alias output __out: f;
    function f(1 * units.deg)
    f
@EXHAUST_LOBE@
}

private node tcc3_wires {
    output wire1: ignition_wire();
}

public node tcc3 {
    input intake_temperature: 318.15 * units.K;
    input intake_pressure: 95.0 * units.kPa;     // supply = measured plenum-inlet pressure (boundary)
    input rod_length: 231.0 * units.mm;
    input wall_temperature: 323.0;
    input plenum_volume: 11.0 * units.L;
    input molecular_afr: 1000000.0;
    input spark: 18 * units.deg;
    input fuel_energy: 46.35 * units.kJ / units.g;
    alias output __out: engine;

    engine engine(
        name: "UM TCC-III",
        starter_torque: 50 * units.lb_ft,
        starter_speed: 400 * units.rpm,
        redline: 3000 * units.rpm,
        fuel: fuel(name: "propane", energy_density: fuel_energy, density: 0.493 * units.kg / units.L,
                   max_burning_efficiency: 0.97, burning_efficiency_randomness: 0.0),
        piston_wall_temperature: wall_temperature,
        head_wall_temperature: wall_temperature,
        liner_wall_temperature: wall_temperature,
        simulation_frequency: 10000,
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.1
    )
    tcc3_wires wires()
    crankshaft c0(
        throw: 43.0 * units.mm,
        flywheel_mass: 10 * units.kg,
        mass: 8 * units.kg,
        friction_torque: 0.0 * units.lb_ft,
        moment_of_inertia: 0.2,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90.0 * units.deg
    )
    rod_journal rj1(angle: 0.0 * units.deg)
    c0
        .add_rod_journal(rj1)
    piston_parameters piston_params(
        mass: 1000 * units.g,
        compression_height: 30.0 * units.mm,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )
    connecting_rod_parameters rod_params(
        mass: 800 * units.g,
        moment_of_inertia: 0.0015,
        center_of_mass: 0.0,
        length: rod_length
    )
    cylinder_bank_parameters bank_params(
        bore: 92.0 * units.mm,
        deck_height: rod_length + 73.0 * units.mm
    )
    intake intake(
        plenum_volume: plenum_volume,
        plenum_cross_section_area: 180.6 * units.cm2,
        intake_flow_rate: k_carb(5000.0),
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.999,
        runner_length: 185.7 * units.mm,
        throttle_gamma: 1.0,
        molecular_afr: molecular_afr,
        velocity_decay: 1.0,
        atmosphere_temperature: intake_temperature,
        atmosphere_pressure: intake_pressure
    )
    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1000.0),
        primary_tube_length: 0 * units.mm,
        primary_flow_rate: k_carb(500.0),
        velocity_decay: 1.0,
        volume: 11.0 * units.L
    )
    exhaust_system exhaust0(es_params, audio_volume: 1.0, impulse_response: ir_lib.mild_exhaust_0)
    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: rj1, intake: intake, exhaust_system: exhaust0,
            ignition_wire: wires.wire1, primary_length: 167.0 * units.mm)
    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    camshaft_parameters cparams(advance: 0 * units.deg, base_radius: 15 * units.mm)
    camshaft intake_cam(cparams, lobe_profile: tcc3_intake_lobe())
    camshaft exhaust_cam(cparams, lobe_profile: tcc3_exhaust_lobe())
    label rot360(360 * units.deg)
    exhaust_cam
        .add_lobe(rot360 - @EXHAUST_CENTER@ * units.deg)
    intake_cam
        .add_lobe(rot360 + @INTAKE_CENTER@ * units.deg)
    b0.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 63.52 * units.cc,
        intake_runner_volume: 47.75 * units.cc,
        intake_runner_cross_section_area: 5.067 * units.cm2,
        exhaust_runner_volume: 47.75 * units.cc,
        exhaust_runner_cross_section_area: 5.067 * units.cm2,
        intake_port_flow: tcc3_intake_flow(),
        exhaust_port_flow: tcc3_exhaust_flow(),
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam, exhaust_camshaft: exhaust_cam)))

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, spark)
        .add_sample(5000 * units.rpm, spark)
    engine.add_ignition_module(
        ignition_module(timing_curve: timing_curve, rev_limit: 3500 * units.rpm)
            .connect_wire(wires.wire1, 0.0 * units.deg))
}
